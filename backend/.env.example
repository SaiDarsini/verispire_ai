# --- AI Provider ---
AI_PROVIDER=gemini
GEMINI_API_KEY=AQ.Ab8RN6IILiScM1ui14k867o6DDlyza-7xQNW_AB4Cb2m1NBj3w
GEMINI_MODEL=gemini-2.5-flash
