# --- App ---
APP_NAME=VICTORUS AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
DATABASE_URL=postgresql+psycopg2://victorus_user:victorus_pass@localhost:5432/victorus_db

# --- CORS ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# --- File Uploads ---
UPLOAD_DIR=app/uploads
MAX_UPLOAD_MB=15

# --- Email (used later for real SMTP; currently logs to console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@victorus.ai

# --- Local AI (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_TIMEOUT_SECONDS=120
